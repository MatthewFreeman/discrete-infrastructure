[Unit]
Description=Metrics monitor for the temporary Discrete benchmark daemon
After=discrete-benchmark-daemon.service

[Service]
Type=simple
User=serveradmin
Group=serveradmin
EnvironmentFile=/opt/discrete-benchmark/state/v.0.9.5/current.env
ExecStart=/opt/discrete-benchmark/harness/v.0.9.5/monitor.sh
Restart=no
Nice=10
UMask=0022
RuntimeDirectory=discrete-benchmark
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
