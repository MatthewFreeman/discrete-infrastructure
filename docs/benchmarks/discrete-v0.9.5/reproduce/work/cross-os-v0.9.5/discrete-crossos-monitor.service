[Unit]
Description=Metrics monitor for Discrete v.0.9.5 cross-OS benchmark
After=discrete-crossos-daemon.service

[Service]
Type=simple
User=serveradmin
Group=serveradmin
EnvironmentFile=/opt/discrete-benchmark/state/v.0.9.5/cross-os/current.env
ExecStart=/opt/discrete-benchmark/harness/v.0.9.5/cross-os/monitor.sh
Restart=no
Nice=10
UMask=0022
RuntimeDirectory=discrete-crossos-benchmark
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
