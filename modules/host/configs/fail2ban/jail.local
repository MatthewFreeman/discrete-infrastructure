[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5

usedns = no

banaction = nftables[type=multiport,actionstart_on_demand=false,table_family=ip]
banaction_allports = nftables[type=allports,actionstart_on_demand=false,table_family=ip]

[sshd]
enabled = true
backend = systemd
mode = normal
port = 22822
protocol = tcp
